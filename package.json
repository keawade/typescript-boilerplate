{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "ts-boilerplate",
  "version": "1.0.0",
  "main": "main.ts",
  "type": "module",
  "author": "keawade",
  "license": "MIT",
  "description": "",
  "scripts": {
    "start": "node src/main.ts",
    "start:dev": "nodemon",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "format": "prettier . --write --list-different",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "fastify": "^5.8.4",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  }
}
